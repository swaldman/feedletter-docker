# Copy to .env and edit. Read by docker-compose.yml.

# Public hostname for the web API. Must resolve (DNS) to this host, with
# ports 80 and 443 reachable, for Caddy to obtain a Let's Encrypt cert.
FEEDLETTER_DOMAIN=feedletter.example.com

# Address for Let's Encrypt expiry/issue notifications (optional).
ACME_EMAIL=you@example.com

# Postgres password. Must match feedletter.jdbc.password in the secrets file.
POSTGRES_PASSWORD=CHANGE_ME

# Host loopback port published for an external reverse proxy to target. Only
# used in the "behind your own TLS / proxy" mode (caddy commented out, and
# feedletter's ports block uncommented in docker-compose.yml). Pick a port
# that doesn't collide with anything else on the host; proxy to 127.0.0.1:<this>.
FEEDLETTER_HTTP_PORT=8024
