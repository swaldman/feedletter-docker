# ---------------------------------------------------------------------------
# Copy this file to  secrets/feedletter-secrets.properties  and fill it in.
#
# IMPORTANT: feedletter refuses to read a secrets file with loose permissions.
# After creating it, run:   chmod 600 secrets/feedletter-secrets.properties
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Host "db" is the Postgres service name in docker-compose.yml.
# The user/db ("feedletter") match POSTGRES_USER / POSTGRES_DB there;
# the password MUST equal POSTGRES_PASSWORD from your .env file.
feedletter.jdbc.url=jdbc:postgresql://db:5432/feedletter
feedletter.jdbc.user=feedletter
feedletter.jdbc.password=CHANGE_ME_SAME_AS_POSTGRES_PASSWORD

# --- Secret salt ----------------------------------------------------------
# Arbitrary but STABLE string; used to sign subscription confirmation/removal
# links. Changing it later invalidates outstanding links. Generate once, e.g.
#   openssl rand -hex 32
feedletter.secret.salt=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Outgoing mail (SMTP) -------------------------------------------------
# Passed through to JavaMail. Adjust to your provider. See the feedletter
# tutorial for a worked example:
#   https://tech.interfluidity.com/2024/01/29/feedletter-tutorial/index.html
mail.smtp.host=smtp.example.com
mail.smtp.port=587
mail.smtp.auth=true
mail.smtp.starttls.enable=true
mail.smtp.user=feedletter@example.com
mail.smtp.password=CHANGE_ME

# --- Social syndication (optional) ----------------------------------------
# Only needed if you define Mastodon / Bluesky subscribables. The exact key
# names are reported by feedletter when you define such a subscribable.
# mastodon.access.token=...
# bluesky.app.password=...
